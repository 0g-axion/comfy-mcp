{
  "name": "@0g-axion/comfy-mcp",
  "version": "0.6.0",
  "description": "MCP server for Comfy's public reads and unsigned transaction builders on 0G; never signs or sends transactions.",
  "keywords": [
    "0g",
    "comfy",
    "launchpad",
    "mcp",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0g-axion/comfy-mcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "comfy-mcp": "dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --import tsx --test tools.test.mjs server.test.mjs http-session.test.mjs rpc.test.mjs swap.test.mjs creator-fees.test.mjs launch.test.mjs",
    "release:check": "node scripts/check-release.mjs",
    "prepublishOnly": "npm test && npm run release:check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://www.comfy.fun/docs/build/mcp",
  "bugs": {
    "url": "https://github.com/0g-axion/comfy-mcp/issues"
  }
}
